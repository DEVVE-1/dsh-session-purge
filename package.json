{
  "name": "session-purge",
  "version": "1.3.2",
  "repository": "git+https://github.com/DEVVE-1/dsh-session-purge.git",
  "keywords": ["dsh", "deepseek-harness", "dsh-plugin", "cordis", "session", "cleanup"],
  "license": "MIT",
  "description": "右键删除侧边栏会话：连同会话日志、投影缓存与工作区记账一起清干净，不影响其它会话。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/core.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  }
}
